root = true

[*.{c,cc,cpp,cxx,h,hpp,hxx,inl,ipp}]
indent_style = tab
indent_size = 4
tab_width = 4
cpp_indent_style = tab
cpp_indent_size = 4
cpp_tab_width = 4
resharper_cpp_indent_style = tab
resharper_cpp_indent_size = 4
resharper_cpp_tab_width = 4
cpp_alignment_tab_fill_style = use_spaces
resharper_cpp_alignment_tab_fill_style = use_spaces
resharper_cpp_keep_user_linebreaks = true
resharper_cpp_wrap_arguments_style = wrap_if_long
resharper_cpp_wrap_parameters_style = wrap_if_long
max_line_length = 1000